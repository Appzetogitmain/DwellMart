# Environment Variables for Appzeto Multi-Vendor Backend
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Public HTTPS endpoint Cashfree can call after payment (recommended in production)
CASHFREE_NOTIFY_URL=

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/dwellmart_dev

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_access_secret_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_app_password
FROM_NAME=Dwell Mart
FROM_EMAIL=no-reply@example.com

# Integration partner fallback auth (optional)
INTEGRATION_CLIENT_ID=your_client_id
INTEGRATION_API_KEY=your_secret_key
INTEGRATION_API_KEY_PEPPER=
INTEGRATION_PARTNER_NAME=Third Party Logistics Partner
INTEGRATION_SCOPES=orders:read,orders:write,inventory:write

# Stock update strategy for integration callbacks:
# AT_ORDER_PLACEMENT (default) | POST_DELIVERY
INTEGRATION_STOCK_UPDATE_STAGE=AT_ORDER_PLACEMENT

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins, in addition to CLIENT_URL.
# Localhost origins are trusted automatically OUTSIDE production only.
# Never add a preview/staging domain here for a production environment.
CORS_ALLOWED_ORIGINS=https://dwellmart.in,https://www.dwellmart.in

# ─── Environment contract ────────────────────────────────────────────────────
# 'warn' logs CONFIG_VIOLATION lines and boots. 'enforce' refuses to boot.
# Ship 'warn' first; flip to 'enforce' after 48h of zero violations.
ENV_CONTRACT_MODE=warn

# Product field capability guard. Unset = observe-only (logs what WOULD be
# rejected). Set to 'true' only after reviewing those logs.
# PRODUCT_FIELD_STRICT=true
# Canonical multi-channel vendor authorization. Production deploy order:
# migrate first, then deploy with channels authority. `legacy` is rollback-only;
# `shadow` compares legacy projections without granting from vendorType.
VENDOR_CHANNEL_AUTHORITY_MODE=channels

# Product writes reject fields outside the server-validated workspace by default.
PRODUCT_FIELD_STRICT=true

# ─── DTDC Delivery Integration ───────────────────────────────────────────────
DTDC_ENVIRONMENT=sandbox
DTDC_CUSTOMER_CODE=your_dtdc_customer_code_here
DTDC_API_KEY=your_dtdc_api_key_here
DTDC_TRACKING_USERNAME=your_dtdc_tracking_username_here
DTDC_TRACKING_PASSWORD=your_dtdc_tracking_password_here
DTDC_RETAIL_SERVICE_TYPE=B2C PRIORITY
DTDC_WHOLESALE_SERVICE_TYPE=B2C SMART EXPRESS
DTDC_WEBHOOK_SECRET=your_dtdc_webhook_secret_here
DTDC_TIMEOUT_MS=15000
DTDC_RETRY_ATTEMPTS=1

# ─── WhatsApp / Interakt (OTP only) ──────────────────────────────────────────
# Master kill switch. WhatsApp is only ever the FIRST attempt for an OTP;
# email remains the fallback, so disabling this degrades delivery, never breaks it.
WHATSAPP_ENABLED=false
# Build and log the payload without calling Interakt. Costs nothing.
WHATSAPP_DRY_RUN=true
WHATSAPP_OTP_ENABLED=true
# Interakt issues an ALREADY-base64 HTTP Basic token. Sent verbatim as
# `Authorization: Basic <key>` — re-encoding it produces an opaque 401.
INTERAKT_API_KEY=your_interakt_api_key_here
# HMAC-SHA256 secret for the Interakt-Signature header on delivery webhooks.
INTERAKT_WEBHOOK_SECRET=your_interakt_webhook_secret_here
WHATSAPP_BUSINESS_NUMBER=919999999999
WHATSAPP_DEFAULT_COUNTRY_CODE=+91
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TIMEOUT_MS=10000
WHATSAPP_TEST_PHONE=
