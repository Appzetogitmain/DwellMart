# Integration partner fallback auth (optional)
INTEGRATION_CLIENT_ID=your_client_id
INTEGRATION_API_KEY=your_secret_key
INTEGRATION_API_KEY_PEPPER=
INTEGRATION_PARTNER_NAME=Third Party Logistics Partner
INTEGRATION_SCOPES=orders:read,orders:write,inventory:write

# Stock update strategy for integration callbacks:
# AT_ORDER_PLACEMENT (default) | POST_DELIVERY
INTEGRATION_STOCK_UPDATE_STAGE=AT_ORDER_PLACEMENT

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins, in addition to CLIENT_URL.
# Localhost origins are trusted automatically OUTSIDE production only.
# Never add a preview/staging domain here for a production environment.
CORS_ALLOWED_ORIGINS=https://dwellmart.in,https://www.dwellmart.in

# ─── Environment contract ────────────────────────────────────────────────────
# 'warn' logs CONFIG_VIOLATION lines and boots. 'enforce' refuses to boot.
# Ship 'warn' first; flip to 'enforce' after 48h of zero violations.
ENV_CONTRACT_MODE=warn

# Product field capability guard. Unset = observe-only (logs what WOULD be
# rejected). Set to 'true' only after reviewing those logs.
# PRODUCT_FIELD_STRICT=true
