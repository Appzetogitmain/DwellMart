{
  "name": "dwell-mart-backend",
  "version": "1.0.0",
  "description": "Dwell Mart Multi-Vendor E-Commerce Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/migrations/cli.js",
    "migrate:status": "node src/migrations/cli.js --status",
    "migrate:verify": "node src/migrations/cli.js --verify",
    "seed:categories": "node src/scripts/seedCategories.js",
    "seed:policies": "node scripts/seedPolicies.js",
    "test": "node tests/run.mjs",
    "test:gate": "node tests/run.mjs",
    "test:contract": "node tests/run.mjs contract",
    "test:integration": "node tests/run.mjs wholesale quick-commerce authorization",
    "test:conformance": "node scripts/verifyPricingEngineParity.mjs && node scripts/verifyCheckoutPricingMath.mjs && node scripts/verifyWholesaleAnalytics.mjs && node scripts/verifyBulkWholesaleImport.mjs && node scripts/verifyQuickCommerceEtaParity.mjs && node scripts/verifyRiderAssignment.mjs && node scripts/verifyQuickCommercePolish.mjs",
    "test:all": "npm run test:conformance && npm run test:gate",
    "check:hygiene": "node scripts/checkSourceHygiene.js",
    "test:unit": "node tests/unit/security-regression.test.mjs && node --test tests/unit/vendor-channels.test.mjs tests/unit/product-field-ownership.test.mjs tests/unit/channel-remediation.test.mjs tests/unit/vendor-chat-clean.test.mjs tests/unit/dtdc-delivery.test.mjs tests/unit/bulk-upload-shipping.test.mjs tests/unit/phone-e164.test.mjs tests/unit/whatsapp-client.test.mjs tests/unit/whatsapp-otp-channel.test.mjs",
    "test:channels": "node --test tests/unit/vendor-channels.test.mjs",
    "test:integration:isolated": "node --test tests/integration/vendorProductChannels.test.mjs",
    "test:dtdc": "node --test --test-force-exit tests/integration/dtdcDelivery.test.mjs",
    "test:unbooked": "node --test --test-force-exit tests/integration/unbookedOrderAlerts.test.mjs",
    "test:product-shipping": "node --test --test-force-exit tests/integration/productShipping.test.mjs",
    "test:order-snapshot": "node --test --test-force-exit tests/integration/orderShippingSnapshot.test.mjs",
    "test:parcel": "node --test --test-force-exit tests/integration/parcelDeclaration.test.mjs",
    "test:backfill": "node --test --test-force-exit tests/integration/productShippingBackfill.test.mjs",
    "test:deliverability": "node --test --test-force-exit tests/integration/deliverability.test.mjs",
    "ci": "npm run check:hygiene && npm run check:permissions && npm run test:unit && npm run test:whatsapp:integration && npm run test:dtdc && npm run test:unbooked && npm run test:product-shipping && npm run test:order-snapshot && npm run test:parcel && npm run test:backfill && npm run test:deliverability",
    "check:permissions": "node scripts/checkPermissionCoverage.js",
    "test:whatsapp": "node --test tests/unit/phone-e164.test.mjs tests/unit/whatsapp-client.test.mjs tests/unit/whatsapp-otp-channel.test.mjs",
    "test:whatsapp:migration": "node --test --test-force-exit tests/integration/phoneE164Migration.test.mjs",
    "whatsapp:livecheck": "node scripts/whatsappLiveCheck.mjs",
    "test:whatsapp:integration": "node --test --test-force-exit tests/integration/phoneE164Migration.test.mjs tests/integration/whatsappWebhook.test.mjs tests/integration/whatsappOtpE2E.test.mjs"
  },
  "author": "furqan",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/translate": "^9.3.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "sanitize-html": "^2.17.6",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.9"
  }
}
